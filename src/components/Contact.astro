---
import SectionTitle from './ui/SectionTitle.astro'
import Form from './ui/Form.astro'
---

<section
  class='mt-20 bg-stone-900 -mx-[calc((100vw-theme(maxWidth.7xl))/2)] px-[calc((100vw-theme(maxWidth.7xl))/2)] py-10'>
  <SectionTitle
    title='Contact'
    id='contact'
  />
  <main class='mt-4'>
    <div class='flex items-baseline'>
      <div class='w-2/3 text-7xl font-semibold text-stone-100 mb-10'>
        <h1>Hey There,<br />Let's Connect</h1>
      </div>
    </div>
    <Form />
  </main>
  <hr class='mt-20 border-stone-400' />
</section>

<style>
  h1 {
    font-family: 'Geist-Light', sans-serif;
    line-height: 1.2;
  }
  p {
    font-family: 'Geist-Light', sans-serif;
  }
  label {
    font-family: 'Geist-Regular', sans-serif;
  }
</style>
