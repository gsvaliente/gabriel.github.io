---
import SectionTitle from './ui/SectionTitle.astro'
---

<section class='my-20'>
  <SectionTitle
    title='About Me'
    id='about'
  />
  <div class='mt-4 flex justify-between items-end'>
    <p class='text-stone-900 font-semibold text-4xl w-1/2'>
      I'm a marketer turned developer creating digital experiences. I'm a
      self-taught developer with a passion for creating digital experiences.
    </p>
    <p class='text-stone-500 font-regular text-2xl w-1/3'>
      For me, the most important thing is to create an experience that the user
      will not forget.
    </p>
  </div>
</section>

<style>
  p {
    line-height: 1.2;
    font-family: 'Geist-Light';
  }
</style>
