---

---

<div class='flex flex-col relative screen-height pb-20'>
  <div class='flex justify-end w-full h-full pt-20'>
    <img
      src='/foto-perfil.jpeg'
      alt='hero'
      class='w-80 h-90 object-cover rounded-2xl'
    />
  </div>
  <div class='absolute bottom-5 right-4 w-52 mb-10'>
    <p class='text-lg text-right font-semibold leading-5.5'>
      Hi, I'm Gabriel. A marketer turned developer creating digital experiences.
    </p>
  </div>
  <div
    class='absolute bottom-0 left-0 flex flex-col leading-none mb-10 tracking-tight'>
    <span class='hero-text'>Frontend</span>
    <span class='hero-text'>Developer</span>
  </div>

  <style>
    .screen-height {
      height: calc(100vh - 100px);
    }
    .hero-text {
      font-size: 11rem;
      font-weight: 300;
      font-family: 'Geist-Light', sans-serif;
    }
    p {
      font-family: 'Geist-Regular', sans-serif;
    }
  </style>
</div>
