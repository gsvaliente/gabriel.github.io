---
import SectionTitle from './ui/SectionTitle.astro'
import CardSection from './ui/CardSection.astro'
import { serviceArray } from '../consts/services'
---

<section class='mb-20'>
  <SectionTitle
    title='Services'
    id='services'
  />
  <div class='mt-4 flex items-start flex-col md:flex-row justify-between'>
    <div class='w-1/3'>
      <p class='text-stone-900 font-semibold text-4xl mb-5'>
        Comprehensive list of the services I offer
      </p>
      <p class='text-stone-500 font-regular text-xl'>
        Actively working on adding new technologies and trends to offer my
        clients
      </p>
      <button
        class='bg-stone-900 text-stone-200 px-4 py-3 mt-6 rounded-full border border-slate-900 hover:bg-slate-900 transition-all duration-300 cursor-pointer'
        ><a href='#contact'>Let's Chat</a>
      </button>
    </div>
    <div class='w-2/3 flex justify-end pr-2'>
      <div class='grid grid-cols-2 gap-4'>
        {
          serviceArray.map((service) => (
            <CardSection
              title={service.title}
              description={service.description}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  p {
    line-height: 1.2;
    font-family: 'Geist-Light', sans-serif;
  }
</style>
