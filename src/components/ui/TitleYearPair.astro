---
interface Props {
  title: string
  description: string
  years: string
}

const { title, description, years } = Astro.props as Props
---

<div
  class='flex justify-between hover:bg-stone-200 -mx-[calc((100vw-theme(maxWidth.7xl))/2)] px-[calc((100vw-theme(maxWidth.7xl))/2)] py-8'>
  <div class='w-2/3'>
    <h1 class='text-2xl text-stone-900 font-semibold'>{title}</h1>
    <p class='text-stone-500 text-md'>{description}</p>
  </div>
  <div class='w-1/3 text-right'>
    <p class='text-5xl font-stone-900 font-extrabold'>{years}</p>
  </div>
</div>

<style>
  h1 {
    font-family: 'Geist-Regular', sans-serif;
  }
  p {
    font-family: 'Geist-Regular', sans-serif;
  }
</style>
