---
interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props as Props
---

<div
  class='group flex flex-col bg-stone-200 rounded-2xl p-4 h-80 w-80
         transition-all duration-500 ease-in-out
         hover:scale-105 hover:bg-stone-900 hover:text-stone-300 text-stone-900'>
  <div
    class='w-1/3 border rounded-full border-stone-900 mb-7 mt-4
              transition-all duration-500 ease-in-out group-hover:w-full group-hover:border-stone-300'>
    <hr />
  </div>

  <h2 class='font-light text-4xl mb-5 transition-colors duration-500'>
    {title}
  </h2>

  <p
    class='font-regular text-md text-stone-500 transition-colors group-hover:text-stone-200 duration-500 leading-5'>
    {description}
  </p>

  <p
    class='mt-auto self-end text-4xl transform transition-transform duration-500 group-hover:translate-x-1 group-hover:-rotate-45 pr-2'>
    →
  </p>
</div>

<style>
  h2 {
    font-family: 'Geist-Light', sans-serif;
  }
</style>
