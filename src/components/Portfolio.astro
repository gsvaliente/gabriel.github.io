---
import SectionTitle from './ui/SectionTitle.astro'
---

<section class='my-20'>
  <SectionTitle
    title='Portfolio'
    id='portfolio'
  />
  <div class='mt-4 flex justify-between items-end mb-10'>
    <p class='text-stone-900 font-semibold text-4xl w-1/2'>
      Explore My portfolio of past and current Projects
    </p>
    <p class='text-stone-500 font-regular text-xl w-1/3'>
      For me, the most important thing is to create an experience that the user
      will not forget.
    </p>
  </div>

  <main class='grid grid-cols-1 lg:grid-cols-3 gap-4'>
    <div class='rounded-4xl bg-stone-400 h-72 w-full'></div>
    <div class='rounded-4xl bg-stone-400 h-72 w-full'></div>
    <div class='rounded-4xl bg-stone-400 h-72 w-full'></div>
    <div class='rounded-4xl bg-stone-400 h-72 w-full'></div>
    <div class='rounded-4xl bg-stone-400 h-72 w-full'></div>
    <div class='rounded-4xl bg-stone-400 h-72 w-full'></div>
  </main>
</section>

<style>
  p {
    line-height: 1.2;
    font-family: 'Geist-Light';
  }
</style>
