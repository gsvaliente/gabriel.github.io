---
import { educationArray } from '../consts/education'
import SectionTitle from './ui/SectionTitle.astro'
import TitleYearPair from './ui/TitleYearPair.astro'
---

<section
  class='mt-20 mb-10 bg-stone-100 -mx-[calc((100vw-theme(maxWidth.7xl))/2)] px-[calc((100vw-theme(maxWidth.7xl))/2)] py-10'>
  <SectionTitle
    title='Education'
    id='education'
  />
  <main>
    <div class='flex items-baseline'>
      <div class='w-2/3 text-4xl font-semibold text-stone-900 mb-10'>
        <h1>A Snapshot of<br />My Education and Experience</h1>
      </div>
      <div class='w-1/3 text-xl text-stone-500 font-regular text-right'>
        <p>A collection of my degrees, certifications, and experiences.</p>
      </div>
    </div>
    <div class='flex flex-col'>
      {
        educationArray.map((education) => (
          <TitleYearPair
            title={education.title}
            description={education.description}
            years={education.years}
          />
        ))
      }
    </div>
  </main>
</section>

<style>
  h1 {
    font-family: 'Geist-Light', sans-serif;
    line-height: 1.2;
  }

  p {
    font-family: 'Geist-Light', sans-serif;
  }
</style>
